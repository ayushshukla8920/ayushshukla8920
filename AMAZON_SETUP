// ==UserScript==
// @name         Optmyzr — Force Amazon account "setup in progress" (BT-11113 repro)
// @namespace    optmyzr.dev
// @version      1.0
// @description  Intercepts tools/getAllPlatformsAccountsListAndAccountInfo and forces a chosen Amazon account into the setup-in-progress state (drops it from accountsInfo), or removes it entirely.
// @match        https://local.optmyzr.com/*
// @match        https://tools.stagingopt.uk/*
// @match        https://tools.preprodopt.uk/*
// @match        https://release.preprodopt.uk/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function () {
  "use strict";

  /* ================= CONFIG ================= */
  // Amazon accountid to target. Leave "" to auto-pick the FIRST amazon account.
  const TARGET_ACCOUNT_ID = "";
  // "setupInProgress" -> keep the row, drop its currency info  (reproduces BT-11113)
  // "remove"          -> remove the account from the list entirely
  const MODE = "setupInProgress";
  const LOG = true;
  /* ========================================= */

  const ENDPOINT = "tools/getAllPlatformsAccountsListAndAccountInfo";
  const log = (...a) => LOG && console.log("%c[BT-11113 repro]", "color:#e47911", ...a);

  // find the "amazon" key case-insensitively
  function amazonKey(obj) {
    return Object.keys(obj).find((k) => k.toLowerCase() === "amazon");
  }

  function mutate(payload) {
    let allAccounts, accountsInfo;
    try {
      allAccounts = JSON.parse(payload.allAccounts);
      accountsInfo = JSON.parse(payload.accountsInfo);
    } catch (e) {
      log("payload not in expected shape, leaving untouched", e);
      return payload;
    }

    const key = amazonKey(allAccounts);
    const amazon = (key && allAccounts[key]) || [];
    if (!amazon.length) {
      log("no amazon accounts in response — nothing to do");
      return payload;
    }

    log(
      "available amazon accounts:",
      amazon.map((a) => `${a.accountid} (${a.accountname})`)
    );

    let targetId = String(TARGET_ACCOUNT_ID || amazon[0].accountid);
    if (!TARGET_ACCOUNT_ID)
      log("no TARGET_ACCOUNT_ID set — auto-picked:", targetId);

    if (MODE === "remove") {
      allAccounts[key] = amazon.filter((a) => String(a.accountid) !== targetId);
      delete accountsInfo[targetId];
      log("removed amazon account entirely:", targetId);
    } else {
      // setup-in-progress: present in allAccounts, missing from accountsInfo
      delete accountsInfo[targetId];
      log("forced amazon account into setup-in-progress:", targetId);
    }

    return {
      ...payload,
      allAccounts: JSON.stringify(allAccounts),
      accountsInfo: JSON.stringify(accountsInfo),
    };
  }

  const origFetch = window.fetch;
  window.fetch = async function (...args) {
    const res = await origFetch.apply(this, args);
    try {
      const url =
        typeof args[0] === "string" ? args[0] : (args[0] && args[0].url) || "";
      if (url.includes(ENDPOINT)) {
        const data = await res.clone().json();
        log("intercepted", url);
        return new Response(JSON.stringify(mutate(data)), {
          status: res.status,
          statusText: res.statusText,
          headers: new Headers({ "Content-Type": "application/json" }),
        });
      }
    } catch (e) {
      log("interception error — returning original response", e);
    }
    return res;
  };

  log("installed · endpoint:", ENDPOINT, "· mode:", MODE);
})();
